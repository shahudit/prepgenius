# Copy this file to ".env" (same folder as pom.xml) and fill in your values.
# Spring Boot auto-loads it on startup (see spring.config.import in
# application.properties) - no manual "export" needed.

# --- MongoDB ---
# Local MongoDB (default, works out of the box if you have `mongod` running,
# or via `docker compose up -d mongo` from the project root):
MONGODB_URI=mongodb://localhost:27017/prepgenius

# MongoDB Atlas (production / cloud): comment the line above and use this
# instead, with your real cluster credentials:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/prepgenius?retryWrites=true&w=majority

# --- JWT ---
# Must be a valid Base64-encoded string (JJWT decodes it as Base64 before
# using it as an HMAC-SHA256 signing key). Generate your own with:
#   openssl rand -base64 64
JWT_SECRET=024aQBoy46vOjN7UNZjgvuNOZ7RYsuzEgUUWKPcF648ug8njbekSjKMYjDqi/INXh8bC9+6SV8MjHfJ+vS05VA==

# --- Google Gemini (AI question generation & answer evaluation) ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=60

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Default admin account, seeded automatically on first boot ---
ADMIN_EMAIL=admin@prepgenius.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=PrepGenius Admin
